# =============================================================================
# FreightLink agentic AI service (Python) — environment variable reference
# =============================================================================
# Copy to `.env` for local dev. Never commit a file containing real values —
# see ../.gitignore.
# =============================================================================

# This service's own bind info (used by the backend's AgentServiceOptions to
# reach it, and by uvicorn itself)
AGENT_API_BASE_URL=http://localhost:8001
AGENT_SERVICE_PORT=8001

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM provider (ADR-008 addendum: Gemini free tier primary, Ollama fallback)
# -----------------------------------------------------------------------------
# Google Gemini API key (free tier, no credit card) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Generic fallback name — used only if GEMINI_API_KEY is unset
LLM_API_KEY=your-llm-api-key
# Gemini model name
LLM_MODEL=gemini-2.5-flash
# Local Ollama model name, used only if the Gemini call fails (network outage,
# rate limit, etc.) — requires Ollama running locally with this model pulled
OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Inbound auth — checked on this service's own POST /workflows/start
# -----------------------------------------------------------------------------
# Must match the backend's AGENT_SERVICE_API_KEY (backend/.env), sent as the
# X-Internal-Api-Key request header
SHARED_SECRET=your-shared-secret-matching-backend-agent-service-api-key

# -----------------------------------------------------------------------------
# Outbound — calls into the ASP.NET Core backend
# (POST /internal/pricing/estimate, POST /internal/workflows/{runId}/steps)
# -----------------------------------------------------------------------------
BACKEND_BASE_URL=http://localhost:5159
# Must match the backend's INTERNAL_API_KEY (backend/.env), sent as the
# X-Internal-Api-Key request header
BACKEND_INTERNAL_API_KEY=your-internal-api-key-matching-backend

# -----------------------------------------------------------------------------
# Outbound — direct OpenRouteService calls (get_route_and_eta tool, ADR-012
# addendum: called directly by this service, not proxied through the backend)
# -----------------------------------------------------------------------------
OPENROUTESERVICE_API_KEY=your-ors-api-key
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
