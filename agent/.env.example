# =============================================================================
# FreightLink agentic AI service (Python) — environment variable reference
# =============================================================================
# Copy to `.env` for local dev. Never commit a file containing real values —
# see ../.gitignore.
# =============================================================================

# Base URL this service is reachable at (used by backend/frontend callers)
AGENT_API_BASE_URL=http://localhost:8001

# LLM provider API key (NVIDIA NIM or other OpenAI-compatible provider)
NVIDIA_API_KEY=your-nvidia-api-key
# Alternative/generic name if a different LLM provider is used instead
LLM_API_KEY=your-llm-api-key

# LLM endpoint and model to use
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=your-llm-model-name

# Port this service listens on
AGENT_SERVICE_PORT=8001

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
