# =============================================================================
# FreightLink agentic AI service (Python) — environment variable reference
# =============================================================================
# Copy to `.env` for local dev. Never commit a file containing real values —
# see ../.gitignore.
# =============================================================================

# This service's own bind info (used by the backend's AgentServiceOptions to
# reach it, and by uvicorn itself)
AGENT_API_BASE_URL=http://localhost:8001
AGENT_SERVICE_PORT=8001

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM provider (ADR-008 addendum #2: OpenAI is the only LLM provider - supersedes the
# original NVIDIA NIM choice and the interim Gemini switch; see ADR-008 in
# docs/Architecture-Decision-Records.md for the full NVIDIA -> Gemini -> OpenAI story).
# No Gemini, no Ollama, no other fallback provider - if OpenAI is unreachable, each
# agent falls back to its own deterministic, template-based copy instead.
# -----------------------------------------------------------------------------
# OpenAI API key — https://platform.openai.com/api-keys. This is NOT free tier: set a
# hard spend limit / billing alert on the OpenAI account itself as a second layer of
# protection alongside this service's own OPENAI_MAX_CALLS_PER_PROCESS cap below.
OPENAI_API_KEY=your-openai-api-key
# Cheapest OpenAI tier that reliably supports structured output - do not upgrade to a
# flagship model without re-reading plans/00-master-plan.md §3's cost reasoning.
OPENAI_MODEL=gpt-4o-mini
# Hard per-process cap on OpenAI calls (cost guard, plans/03-openai-migration.md §5) - a
# bug that loops/retries the pipeline can't run up unbounded spend past this count.
OPENAI_MAX_CALLS_PER_PROCESS=200

# -----------------------------------------------------------------------------
# Inbound auth — checked on this service's own POST /workflows/run
# -----------------------------------------------------------------------------
# Must match the backend's AGENT_SERVICE_API_KEY (backend/.env), sent as the
# X-Internal-Api-Key request header
SHARED_SECRET=your-shared-secret-matching-backend-agent-service-api-key

# -----------------------------------------------------------------------------
# Routing & Distance Tool (OpenRouteService, ADR-012 — Agent 3)
# -----------------------------------------------------------------------------
# Free tier key from https://openrouteservice.org/dev/#/signup
# If omitted or left as placeholder, Agent 3 uses a simulated road detour calculation.
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org


# -----------------------------------------------------------------------------
# Outbound — calls into the ASP.NET Core backend
# (POST /internal/agent-workflow-runs, POST /internal/agent-workflow-runs/{id}/steps)
# -----------------------------------------------------------------------------
BACKEND_BASE_URL=http://localhost:5159
# Must match the backend's own internal-API key (backend/.env), sent as the
# X-Internal-Api-Key request header
INTERNAL_API_KEY=your-internal-api-key
