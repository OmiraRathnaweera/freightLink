# Variables for the root compose.yaml. Copy this file to `.env` next to compose.yaml and
# edit it; Docker Compose reads `.env` automatically, so this is the only file to change
# for a deployment. Never commit the real `.env`.

# Required. Use a password made from letters/numbers (no semicolon, quote or newline)
# because Compose inserts it into an Npgsql connection string.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
JWT_KEY=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=replace-with-a-long-random-key
AGENT_SHARED_SECRET=replace-with-another-long-random-key
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=replace-with-a-strong-admin-password

# Deployment settings. Compose defaults to Production; the `migrate` service applies the
# database migrations before the API starts, so no manual migration step is needed.
ASPNETCORE_ENVIRONMENT=Production
# Public hostname Caddy serves the API on (DNS must point at the server for automatic HTTPS).
API_DOMAIN=freightlink.centralindia.cloudapp.azure.com
SWAGGER_ENABLED=true
# Exact origin(s) of the Vercel frontend, comma-separated (no trailing slash).
CORS_ORIGINS=https://your-app.vercel.app
FRONTEND_BASE_URL=https://your-app.vercel.app
# Host ports for Caddy; change only if 80/443 are already taken (e.g. on a dev machine).
HTTP_PORT=80
HTTPS_PORT=443

# Optional database and local API port settings.
POSTGRES_DB=freightlink
POSTGRES_USER=freightlink
API_LOCAL_PORT=5159

# Optional external services. OpenAI and ORS have deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTESERVICE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email delivery.
EMAIL_ENABLED=false
EMAIL_SANDBOX_MODE=true
EMAIL_REQUIRE_VERIFICATION=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
