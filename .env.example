# Host variables used by the root compose.yaml. Export these from your shell or a
# deployment secret store before running Docker Compose. This file is a reference.

# Required. Use a password made from letters/numbers (no semicolon, quote or newline)
# because Compose inserts it into an Npgsql connection string.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
JWT_KEY=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=replace-with-a-long-random-key
AGENT_SHARED_SECRET=replace-with-another-long-random-key
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=replace-with-a-strong-admin-password

# Local default is Development. Set these URLs and origins for the Azure VPS.
ASPNETCORE_ENVIRONMENT=Development
API_DOMAIN=api.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# Optional database and local API port settings.
POSTGRES_DB=freightlink
POSTGRES_USER=freightlink
API_LOCAL_PORT=5159

# Optional external services. OpenAI and ORS have deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTESERVICE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email delivery.
EMAIL_ENABLED=false
EMAIL_SANDBOX_MODE=true
EMAIL_REQUIRE_VERIFICATION=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
