# =============================================================================
# FreightLink frontend (React / Vite) — environment variable reference
# =============================================================================
# Copy to `.env` (or `.env.local`) for local dev. Only variables prefixed
# `VITE_` are exposed to client code — see src/lib/apiClient.js.
# Never commit a file containing real values — see ../.gitignore.
# =============================================================================

# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:5159/api/v1

# Display name used in the UI
VITE_APP_NAME=FreightLink
