# =============================================================================
# FreightLink backend (ASP.NET Core API) — environment variable reference
# =============================================================================
# Copy to `.env` for local dev (e.g. with `docker compose` / a `.env`-loading
# tool), or set the same keys via `dotnet user-secrets` / real env vars.
# Never commit a file containing real values — see ../.gitignore.
#
# Keys below are SCREAMING_CASE with "__" as a section separator (standard env var style); the
# C# code reads the same keys via ASP.NET Core's config binding (e.g. GetSection("Jwt"),
# GetConnectionString("DefaultConnection")) in mixed case. This is not a casing mismatch to keep
# in sync by hand — ASP.NET Core's environment-variable provider maps "__" to ":" and every
# config lookup is case-insensitive by design, so e.g. JWT__ISSUER and "Jwt:Issuer" are the same
# key. See Program.cs for where each of these is actually read.
# =============================================================================

# Runtime environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# URL(s) the Kestrel server binds to (0.0.0.0 allows connections from Android emulator 10.0.2.2 and LAN devices)
ASPNETCORE_URLS=http://0.0.0.0:5159

# Database connection string ("__" maps to ConnectionStrings:DefaultConnection
# via ASP.NET Core's configuration binding). PostgreSQL/Npgsql syntax.
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=localhost;Port=5432;Database=freightlink;Username=your-db-user;Password=your-db-password;

# JWT auth settings ("__" maps to the Jwt:* configuration section)
JWT__ISSUER=FreightLinkApi
JWT__AUDIENCE=FreightLinkClient
JWT__KEY=1f8267c19deb604d436dd321bfd74bad3491018f7777db5bbb07bbf143cd58b000aa19d5221f27e95525916c9ea18ef2add2642ae4de33d6550db13336364930
JWT__ACCESSTOKENMINUTES=15
JWT__REFRESHTOKENDAYS=7

# OpenRouteService — routing & distance/ETA calculations
OPENROUTESERVICE__APIKEY=your-ors-api-key
OPENROUTESERVICE__BASEURL=https://api.openrouteservice.org

# Cloudinary — shared file storage (cargo photos, trip evidence, compliance docs). Only image files
# and PDFs are accepted — see Common/Validation/FileUploadPolicy.cs. Folder is optional; omit to
# upload to Cloudinary's root.
CLOUDINARY__CLOUDNAME=your-cloudinary-cloud-name
CLOUDINARY__APIKEY=your-cloudinary-api-key
CLOUDINARY__APISECRET=your-cloudinary-api-secret
CLOUDINARY__FOLDER=freightlink

# Local/mounted path used for storing uploaded documents (PODs, compliance docs, etc.)
FILE_STORAGE_PATH=./storage

# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Log verbosity: Trace | Debug | Information | Warning | Error | Critical
LOG_LEVEL=Information

ADMIN_USER_EMAIL=admin@your-domain.com
ADMIN_USER_PASSWORD=your-admin-password

# Shared secret guarding internal-only, non-JWT endpoints (e.g. POST /internal/pricing/estimate,
# POST /internal/agent-workflow-runs/{id}/tool-calls, called by the Python Agent service).
# Sent as the X-Internal-Api-Key request header.
# IMPORTANT: This MUST MATCH the INTERNAL_API_KEY set in agent/.env.
INTERNAL_API_KEY=your-internal-api-key

# Outbound call into the Python Agentic AI service (AssignmentService's TriggerAgentWorkflowRunAsync,
# POST {AGENT_API_BASE_URL}/workflows/run). If AGENT_SERVICE_API_KEY is unset, matching fails closed
# with a clear error rather than silently using a hardcoded default (plans/04-backend-integration.md
# §6) — there is no dev-mode fallback here.
# IMPORTANT: AGENT_SERVICE_API_KEY MUST MATCH the SHARED_SECRET set in agent/.env — the two services
# name this same value differently (backend calls it AGENT_SERVICE_API_KEY outbound, Python calls it
# SHARED_SECRET inbound); only the value, not the variable name, needs to match.
AGENT_API_BASE_URL=http://localhost:8001
AGENT_SERVICE_API_KEY=your-shared-secret-matching-agent-shared-secret

# Email — reusable transactional email service (IEmailService / GmailEmailService), Gmail SMTP.
# Internal-only: no controller/endpoint sends email directly; other services call IEmailService.
# EMAIL__PASSWORD must be a Gmail *app password*, not the account password.
# When EMAIL__ENABLED=false, no settings below are required and every send is skipped.
# When EMAIL__SANDBOXMODE=true, no real SMTP connection is made — the message is logged instead.
EMAIL__SMTPHOST=smtp.gmail.com
EMAIL__SMTPPORT=587
EMAIL__ENABLESSL=true
EMAIL__USERNAME=your-gmail@gmail.com
EMAIL__PASSWORD=your-gmail-app-password
EMAIL__FROMNAME=FreightLink
EMAIL__FROMADDRESS=your-gmail@gmail.com
EMAIL__FRONTENDBASEURL=http://localhost:5173
EMAIL__REQUIREEMAILVERIFICATION=true
# Local-development fallback only. Keep false for staging/production.
EMAIL__ALLOWINVALIDCERTIFICATEFORDEVELOPMENT=false
EMAIL__ENABLED=true
EMAIL__SANDBOXMODE=true
