# =============================================================================
# FreightLink mobile app (Flutter) — environment variable reference
# =============================================================================
# Copy to `.env` for local dev. Never commit a file containing real values —
# see ../../.gitignore.
#
# NOTE: Flutter does not read `.env` files natively. To consume these at
# build time, either add the `flutter_dotenv` package and load `.env` as an
# asset, or pass equivalent values via `--dart-define-from-file=.env`.
# =============================================================================

# Base URL of the backend API
API_BASE_URL=http://localhost:5000/api

# Base URL of the agentic AI service, if the app calls it directly
AGENT_API_BASE_URL=http://localhost:8001

# Display name used in the app
APP_NAME=FreightLink
